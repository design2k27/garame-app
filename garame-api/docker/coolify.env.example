APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me
SERVER_NAME=:80
DEFAULT_URI=https://api.example.com

DATABASE_URL=postgresql://garame:change-me@postgres:5432/garame?serverVersion=18&charset=utf8

JWT_SECRET_KEY=/app/config/jwt/private.pem
JWT_PUBLIC_KEY=/app/config/jwt/public.pem
JWT_PASSPHRASE=

MERCURE_URL=https://mercure.example.com/.well-known/mercure
MERCURE_PUBLIC_URL=https://mercure.example.com/.well-known/mercure
MERCURE_JWT_SECRET=change-me

RUN_MIGRATIONS=1
DB_WAIT_RETRIES=30
DB_WAIT_DELAY=2
